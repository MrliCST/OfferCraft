<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>demo</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <java.version>17</java.version>
        <langchain4j.version>1.20.0</langchain4j.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <postgresql.version>42.7.13</postgresql.version>
        <playwright.version>1.57.0</playwright.version>
        <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 响应式栈：接口层返回 Flux，运行在 Netty 上。注意这跟 spring-boot-starter-web 是二选一，
             web 在里面会被当成 servlet 应用，Flux 就不再由 WebFlux 处理了，所以是替换不是叠加。
             阻塞的部分（模型调用、JDBC）由接口层显式丢到 boundedElastic 线程池上。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        

        <!-- langchain4j: 核心 + Spring Boot starter（@AiService 在这个里面，版本由 BOM 的 beta 线托管） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
        </dependency>

        <!-- dao 层：MyBatis-Plus + PostgreSQL -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- HTML → Markdown：帖子正文归一化（S1），进程内、确定性、无损。
             注意 artifactId 是 flexmark-html2md-converter（含 FlexmarkHtmlConverter 类），
             不是 flexmark-html2md。 -->
        <dependency>
            <groupId>com.vladsch.flexmark</groupId>
            <artifactId>flexmark-html2md-converter</artifactId>
            <version>0.64.8</version>
        </dependency>
        <!-- HTML 归一化（S1 前置）：知识星球懒加载图同时带 src(占位) + data-src(真图)，
             用 jsoup 把 data-src 提为唯一 src，避免 flexmark 把图渲染成 :文件名: 占位符。
             jsoup 本就是 flexmark 的传递依赖，这里显式声明以锁定版本、便于直接调用 API。 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.1</version>
        </dependency>

        <!-- 无头浏览器：Playwright Java，给"网页长截图"工具用。
             走系统已安装的 Google Chrome（channel = chrome），不另外下载 Chromium 二进制。
             它自带 driver（driver-bundle 传递依赖），运行时会解到临时目录，不用手动 install。 -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- 跑 LoginStateCapture：登录态存档用。
                 默认 mainClass 写死成它，是为了让命令短到能记住：
                   mvn -o -q compile exec:java
                 想传参数就用 -Dexec.args（端口、输出目录、只存某个站）。
                 不放在 Spring 里跑，是因为存档常常发生在数据库还没起来的时候。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <configuration>
                    <mainClass>com.example.domain.browser.LoginStateCapture</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
